{
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/podyum-sahne",
      "destination": "/podyum-sahne/index.html"
    },
    {
      "source": "/podyum-sahne/",
      "destination": "/podyum-sahne/index.html"
    },
    {
      "source": "/teknik-sergi",
      "destination": "/teknik-sergi/index.html"
    },
    {
      "source": "/teknik-sergi/",
      "destination": "/teknik-sergi/index.html"
    },
    {
      "source": "/sahne",
      "destination": "/sahne/index.html"
    },
    {
      "source": "/sahne/",
      "destination": "/sahne/index.html"
    },
    {
      "source": "/birlesik-1903",
      "destination": "/onceki-ana-sayfa.html"
    },
    {
      "source": "/dila",
      "destination": "/dila/index.html"
    },
    {
      "source": "/dila/",
      "destination": "/dila/index.html"
    },
    {
      "source": "/podyum-sahne/kapi",
      "destination": "/podyum-sahne/kapi/index.html"
    },
    {
      "source": "/podyum-sahne/kapi/",
      "destination": "/podyum-sahne/kapi/index.html"
    }
  ],
  "buildCommand": "node yayin-kontrol.cjs"
}